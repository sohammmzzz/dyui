---
/**
 * The landing page's live demo: the real DyUI web app, built in demo mode (web/src/demo/,
 * `vite build --mode demo`, copied to public/demo/ by scripts/prebuild.mjs), playing the
 * `dyui demo` script in the browser. No server, no API key, nothing stored.
 *
 * It fills its whole scroll stop edge to edge — a slim label bar, then the app — so the stop
 * reads as a chat app of its own; only scrolling away reveals the site around it.
 *
 * The frame follows the Starlight theme: the first theme goes in the `?theme=` query, later
 * toggles as `{ source: "dyui-docs", type: "theme", theme }` messages. The demo posts unused
 * wheel / touch scrolling back as `{ source: "dyui-demo", type: "wheel" | "touch", ... }`
 * (contract in web/src/demo/embed.ts) for the page's scroller to consume.
 */
const base = import.meta.env.BASE_URL.replace(/\/?$/, "/");
const src = base + "demo/";
---

<div class="de">
  <p class="de-bar" id="de-title">
    <span class="de-live" aria-hidden="true"></span>
    Live demo <span class="de-sep" aria-hidden="true">·</span> <span class="de-note">deterministic chatbot</span>
  </p>
  <iframe
    class="de-frame"
    data-de-src={src}
    title="DyUI live demo: a chat app with a scripted, deterministic model"
    loading="eager"></iframe>
  <script is:inline>
    // set the first theme before the frame loads, so it never flashes the other one
    (function () {
      var f = document.currentScript && document.currentScript.previousElementSibling;
      if (!f || !f.dataset.deSrc) return;
      var t = document.documentElement.dataset.theme;
      f.src = f.dataset.deSrc + (t === "light" || t === "dark" ? "?theme=" + t : "");
    })();
  </script>
  <noscript><p class="de-noscript">The live demo needs JavaScript. Run <code>pip install dyui && dyui demo</code> to try it locally.</p></noscript>
</div>

<script>
  // keep the frame on the page's theme
  const frame = document.querySelector<HTMLIFrameElement>(".de-frame");
  if (frame) {
    const send = () => {
      const theme = document.documentElement.dataset.theme;
      if (theme === "light" || theme === "dark") frame.contentWindow?.postMessage({ source: "dyui-docs", type: "theme", theme }, location.origin);
    };
    frame.addEventListener("load", send);
    new MutationObserver(send).observe(document.documentElement, { attributes: true, attributeFilter: ["data-theme"] });
  }
</script>

<style>
  .de {
    display: flex;
    flex-direction: column;
    block-size: 100%;
    min-inline-size: 0;
    background: var(--dy-bg);
  }
  /* one quiet line: what this is, nothing more */
  .de-bar {
    flex: 0 0 auto;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    margin: 0;
    padding: 0.5rem 1rem;
    border-bottom: 1px solid var(--dx-hair);
    background: var(--dy-bg-subtle);
    font: 500 11px/1.2 var(--dy-font-mono);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--dy-text-muted);
  }
  .de-note {
    color: var(--dy-text);
  }
  .de-live {
    inline-size: 6px;
    block-size: 6px;
    border-radius: 50%;
    background: var(--dy-teal);
    box-shadow: 0 0 0 3px color-mix(in oklab, var(--dy-teal) 22%, transparent);
  }
  .de-frame {
    flex: 1 1 auto;
    display: block;
    inline-size: 100%;
    min-block-size: 0;
    border: 0;
    background: var(--dy-bg);
    color-scheme: normal;
  }
  .de-noscript {
    margin: 0;
    padding: 2rem;
    color: var(--sl-color-gray-3);
  }
</style>
