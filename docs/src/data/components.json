      "name": "markdown",
      "class": "Markdown",
      "group": "content",
      "llm": true,
      "description": "Rich text (Markdown) inside layouts.",
      "details": "Use it to place prose inside a `card`, `grid`, `tabs` or `accordion`. Raw HTML in the Markdown is never rendered.",
      "signature": "markdown(text: string) — Rich text (Markdown) inside layouts.",
      "positional": [
        "text"
      ],
      "varargs": null,
      "fields": [
        {
          "name": "text",
          "type": "string",
          "required": true,
          "default": null,
          "positional": true,
          "description": ""
        }
      ],
      "python": [
        "ui.Markdown(\"**Two nights** in Alfama, then a day in Sintra.\")"
      ],
      "llm_examples": [
        {
          "text": "**Note:** prices include taxes."
        }
      ]
    },
