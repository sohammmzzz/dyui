---
import { Code } from "@astrojs/starlight/components";
import LiveChat from "./LiveChat.tsx";
import Marquee from "./Marquee.tsx";
import { Rendered } from "./ComponentDemo.tsx";
import data from "../data/components.json";
import wordmarkLight from "../../../brand/wordmark.svg";
import wordmarkDark from "../../../brand/wordmark-dark.svg";

const base = import.meta.env.BASE_URL.replace(/\/?$/, "/");
const href = (p: string) => base + p.replace(/^\//, "");
const llmCount = data.components.filter((c) => c.llm).length;
const MODEL = "nvidia/moonshotai/kimi-k2.6";

const appPy = `import dyui

app = dyui.App(title="Travel Bot", starters=["Plan a weekend in Lisbon"])

@app.on_message
async def reply(msg: dyui.Message, chat: dyui.Chat):
    async for part in dyui.llm.stream("${MODEL}", chat.history,
                                      system="You are a calm, expert travel agent.",
                                      components=app.catalog):
        yield part`;

// "How it works" — three real artefacts of one reply.
const handlerPy = `@app.on_message
async def reply(msg, chat):
    async for part in dyui.llm.stream(
        "${MODEL}",
        chat.history,
        components=app.catalog,
    ):
        yield part`;
const stat = data.components.find((c) => c.name === "stat")!;
const statProps = stat.llm_examples[0] as Record<string, unknown>;
const replyText = "Revenue is up this month.";
const modelReply = `${replyText}\n\`\`\`dyui\n${JSON.stringify({ ui: "stat", ...statProps })}\n\`\`\``;

const features = [
  ["The model renders the interface", "DyUI writes the component section of your system prompt, parses the model's reply while it streams, validates every component and renders it between sentences."],
  ["A finished chat app", "History, stop and regenerate, editing, uploads, feedback, light and dark themes, a mobile layout and an optional password — with calm motion on every interaction."],
  ["Any model, any framework", "NVIDIA NIM, OpenAI, Anthropic, Ollama, Groq, OpenRouter, Gemini, Mistral, DeepSeek, Together, xAI and LangGraph — or your own SDK. Anything that streams text works."],
  ["Components in pure Python", "Describe a component as a pydantic model with a render() method. The model learns it on the next turn; the prompt grows with your app."],
  ["Interfaces that answer back", "Buttons, forms, choices and approvals reach your Python handlers or go straight back to the model. await chat.ask(...) pauses for a human decision."],
  ["The model only sends data", "No HTML from the model, filtered links, verified actions, and developer HTML rendered in a sandboxed iframe."],
];

const GROUPS: Array<[string, string]> = [
  ["content", "Content"], ["data", "Data"], ["media", "Media"], ["interactive", "Interactive"],
  ["layout", "Layout"], ["agent", "Agent"], ["developer", "Developer-only"],
];
const groups = GROUPS.map(([id, label]) => ({ id, label, count: data.components.filter((c) => c.group === id).length }));
const pad = (n: number) => String(n).padStart(2, "0");
---

<div class="lp not-content">
  <!-- ─────────────── hero -->
  <section class="lp-hero" aria-labelledby="lp-title">
    <p class="lp-eyebrow">Open source <span aria-hidden="true">·</span> Python 3.10+ <span aria-hidden="true">·</span> MIT licensed</p>
    <h1 id="lp-title" class="lp-title">Chatbots that answer in&nbsp;<em>interfaces</em>.</h1>
    <p class="lp-lede">
      DyUI is a Python framework for professional chat apps. Write one file, run
      <code>dyui run</code>, and your model replies with tables, charts, cards, forms and buttons — not just text.
    </p>
    <div class="lp-actions">
      <a class="lp-btn lp-btn--primary" href={href("get-started/quickstart/")}>
        Start the quickstart
        <svg aria-hidden="true" viewBox="0 0 16 16" width="14" height="14"><path d="M3 8h9.5M8.5 4l4 4-4 4" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </a>
      <a class="lp-btn" href={href("components/")}>Browse components</a>
    </div>
    <div class="lp-cmd">
      <span class="lp-cmd-prompt" aria-hidden="true">$</span>
      <code>pip install dyui</code>
      <button type="button" class="lp-copy" data-copy="pip install dyui" aria-label="Copy the install command">
        <svg class="lp-copy-icon" aria-hidden="true" viewBox="0 0 16 16" width="14" height="14"><rect x="5.5" y="5.5" width="8" height="8" rx="1.8" fill="none" stroke="currentColor" stroke-width="1.3"/><path d="M10.5 3.2v-.1A1.6 1.6 0 0 0 8.9 1.5H3.1a1.6 1.6 0 0 0-1.6 1.6v5.8a1.6 1.6 0 0 0 1.6 1.6h.1" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round"/></svg>
        <svg class="lp-copy-done" aria-hidden="true" viewBox="0 0 16 16" width="14" height="14"><path d="M3 8.5l3.2 3.2L13 4.8" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
        <span class="lp-copy-label" aria-live="polite">Copy</span>
      </button>
    </div>
  </section>

  <!-- ─────────────── the live demo -->
  <section class="lp-stage" aria-label="Live demo">
    <LiveChat client:load />
  </section>

  <!-- ─────────────── how it works -->
  <section class="lp-section" aria-labelledby="lp-how-title">
    <header class="lp-head">
      <p class="lp-eyebrow">How it works</p>
      <h2 id="lp-how-title" class="lp-h2">Text in, interface out</h2>
      <p class="lp-sub">The model never writes markup. It writes data in a format DyUI taught it, and DyUI turns that into real components.</p>
    </header>
    <ol class="lp-plates">
      <li class="lp-plate">
        <p class="lp-plate-n"><span>01</span></p>
        <div class="lp-plate-copy">
          <h3>You write Python</h3>
          <p>One handler streams the model. <code>app.catalog</code> tells DyUI which components to describe in the system prompt.</p>
        </div>
        <div class="lp-plate-art">
          <Code code={handlerPy} lang="python" title="app.py" />
        </div>
      </li>
      <li class="lp-plate">
        <p class="lp-plate-n"><span>02</span></p>
        <div class="lp-plate-copy">
          <h3>The model writes components</h3>
          <p>Inside its reply, the model writes one JSON object per line in a <code>dyui</code> fence.</p>
        </div>
        <div class="lp-plate-art">
          <Code code={modelReply} lang="md" title="What the model writes" wrap />
        </div>
      </li>
      <li class="lp-plate">
        <p class="lp-plate-n"><span>03</span></p>
        <div class="lp-plate-copy">
          <h3>DyUI renders them</h3>
          <p>Each line is parsed as it streams, validated against the same pydantic model, and rendered between sentences.</p>
        </div>
        <div class="lp-plate-art">
          <Rendered client:visible ui="stat" props={statProps} text={replyText} />
        </div>
      </li>
    </ol>
  </section>

  <!-- ─────────────── what you get -->
  <section class="lp-section" aria-labelledby="lp-features-title">
    <header class="lp-head">
      <p class="lp-eyebrow">What you get</p>
      <h2 id="lp-features-title" class="lp-h2">A finished chat app around your model</h2>
    </header>
    <dl class="lp-ledger">
      {features.map(([title, body], i) => (
        <div class="lp-ledger-row">
          <span class="lp-ledger-n" aria-hidden="true">{pad(i + 1)}</span>
          <dt>{title}</dt>
          <dd>{body}</dd>
        </div>
      ))}
    </dl>
  </section>

  <!-- ─────────────── components -->
  <section class="lp-section lp-components" aria-labelledby="lp-comp-title">
    <header class="lp-head lp-head--row">
      <div>
        <p class="lp-eyebrow">Component library</p>
        <h2 id="lp-comp-title" class="lp-h2">{llmCount} components the model can use</h2>
        <p class="lp-sub">Each one streams in while the model is still writing it, works in light and dark, and is keyboard accessible.</p>
      </div>
      <a class="lp-link" href={href("components/")}>
        See every component
        <svg aria-hidden="true" viewBox="0 0 16 16" width="14" height="14"><path d="M3 8h9.5M8.5 4l4 4-4 4" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </a>
    </header>
    <ul class="lp-groups">
      {groups.map((g) => (
        <li>
          <a href={href(`components/#${g.id}`)}>
            <span class="lp-group-count">{pad(g.count)}</span>
            <span class="lp-group-name">{g.label}</span>
          </a>
        </li>
      ))}
    </ul>
    <Marquee client:visible />
  </section>

  <!-- ─────────────── code to result -->
  <section class="lp-section lp-steps" aria-labelledby="lp-steps-title">
    <header class="lp-head">
      <p class="lp-eyebrow">Quickstart</p>
      <h2 id="lp-steps-title" class="lp-h2">From one file to a chat app</h2>
    </header>
    <ol class="lp-steplist">
      <li>
        <h3><span class="lp-step-n" aria-hidden="true">01</span>Install</h3>
        <Code code={'pip install "dyui[openai]"'} lang="bash" />
        <p>The <code>openai</code> extra adds the SDK; <code>anthropic</code>, <code>langgraph</code> and <code>all</code> work the same way.</p>
      </li>
      <li>
        <h3><span class="lp-step-n" aria-hidden="true">02</span>Write <code>app.py</code></h3>
        <Code code={appPy} lang="python" title="app.py" />
        <p>This is the whole app: a title, a starter prompt and one handler.</p>
      </li>
      <li>
        <h3><span class="lp-step-n" aria-hidden="true">03</span>Run it</h3>
        <Code code={"dyui run app.py"} lang="bash" />
        <p>Open <code>http://localhost:8000</code>. The app reloads when you save.</p>
      </li>
    </ol>
  </section>

  <!-- ─────────────── closing -->
  <section class="lp-cta" aria-labelledby="lp-cta-title">
    <div class="lp-cta-copy">
      <p class="lp-eyebrow">No API key needed</p>
      <h2 id="lp-cta-title" class="lp-h2">Try it without an API key</h2>
      <p class="lp-sub">The built-in demo walks through components, actions, steps and approvals with a simulated model.</p>
      <div class="lp-actions">
        <a class="lp-btn lp-btn--primary" href={href("get-started/quickstart/")}>Read the quickstart</a>
        <a class="lp-btn" href="https://github.com/sohammmzzz/dyui">View on GitHub</a>
      </div>
    </div>
    <div class="lp-cta-code">
      <Code code={"pip install dyui\ndyui demo"} lang="bash" />
    </div>
  </section>

  <footer class="lp-footer">
    <div class="lp-footer-brand">
      <img class="lp-wordmark lp-wordmark--light" src={wordmarkLight.src} alt="DyUI" width="67" height="28" />
      <img class="lp-wordmark lp-wordmark--dark" src={wordmarkDark.src} alt="DyUI" width="67" height="28" />
      <p>Chatbots that answer in interfaces.</p>
    </div>
    <nav class="lp-footer-nav" aria-label="Footer">
      <div>
        <p class="lp-eyebrow">Learn</p>
        <a href={href("get-started/installation/")}>Installation</a>
        <a href={href("get-started/quickstart/")}>Quickstart</a>
        <a href={href("concepts/how-it-works/")}>How DyUI works</a>
      </div>
      <div>
        <p class="lp-eyebrow">Build</p>
        <a href={href("components/")}>Components</a>
        <a href={href("cookbook/travel-bot/")}>Cookbook</a>
        <a href={href("reference/cli/")}>Reference</a>
      </div>
      <div>
        <p class="lp-eyebrow">Project</p>
        <a href="https://github.com/sohammmzzz/dyui">GitHub</a>
        <a href="https://pypi.org/project/dyui/">PyPI</a>
        <a href={href("changelog/")}>Changelog</a>
      </div>
    </nav>
    <p class="lp-footer-fine">MIT licensed.</p>
  </footer>
</div>

<script>
  // copy affordance for the hero install command
  for (const btn of document.querySelectorAll<HTMLButtonElement>("[data-copy]")) {
    const label = btn.querySelector(".lp-copy-label");
    let timer = 0;
    btn.addEventListener("click", async () => {
      try {
        await navigator.clipboard.writeText(btn.dataset.copy ?? "");
      } catch {
        return;
      }
      btn.dataset.copied = "";
      if (label) label.textContent = "Copied";
      clearTimeout(timer);
      timer = window.setTimeout(() => {
        delete btn.dataset.copied;
        if (label) label.textContent = "Copy";
      }, 1800);
    });
  }
</script>
